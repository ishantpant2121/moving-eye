# ──────────────────────────────────────────────────────────
# ApexBot Paper Trading — Environment Variables
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your credentials.
#   cp .env.example .env

# Telegram Bot API (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# CoinDCX API Keys (optional for paper trading, required for live)
COINDCX_API_KEY=your_api_key_here
COINDCX_SECRET=your_api_secret_here
